# Скопируйте в .env в корне проекта и заполните значения:
# cp .env.example .env

# Supabase (URL и service role / anon key вашего проекта)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Telegram Login Widget — бот, через которого пользователи входят на сайт
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username

# Секрет для подписи сессий (сгенерируйте: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-this

# URL фронтенда (для CORS и редиректов)
FRONTEND_URL=http://127.0.0.1:80

# development — проверка подписи Telegram отключена; production — включена
ENVIRONMENT=development

# Опционально: список разрешённых origins через запятую
# CORS_ORIGINS=http://127.0.0.1:80,http://localhost:80

# --- Для production (docker-compose.prod.yml) ---
# VITE_API_URL=https://example.com/api
# VITE_AUTH_URL=https://example.com/bots
