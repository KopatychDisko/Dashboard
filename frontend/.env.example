# Скопируйте в frontend/.env и заполните значения:
# cp .env.example .env

# Имя Telegram-бота для виджета входа (без @)
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# URL API бэкенда
VITE_API_URL=http://localhost:8000/api

# URL редиректа после авторизации через Telegram Widget
VITE_AUTH_URL=http://127.0.0.1/bots
